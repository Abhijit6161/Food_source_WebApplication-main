{
  "name": "food-source-app",
  "version": "1.0.0",
  "description": "Full-Stack MERN Food Delivery Application",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "build": "npm --prefix server install && npm --prefix client install && npm --prefix client run build",
    "setup": "npm install && npm --prefix server install && npm --prefix client install",
    "server": "npm --prefix server run dev",
    "client": "npm --prefix client run dev",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "seed": "npm --prefix server run seed"
  },
  "keywords": [
    "mern",
    "food-delivery",
    "react",
    "express",
    "mongodb",
    "nodejs"
  ],
  "author": "Abhijit More",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "dotenv": "^18.0.5",
    "mongoose": "^9.10.3"
  }
}
